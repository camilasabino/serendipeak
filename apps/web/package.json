{
	"name": "serendipeak-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"cesium:assets": "node scripts/copy-cesium-assets.mjs",
		"predev": "npm run cesium:assets",
		"dev": "next dev",
		"prebuild": "npm run cesium:assets",
		"build": "next build",
		"start": "next start",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"check:production-gate": "node ../../scripts/production-gate.mjs .next",
		"test:e2e": "playwright test",
		"test:ssr": "NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:${STUB_API_PORT:-8099} next build && playwright test --project=ssr"
	},
	"dependencies": {
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/spectral": "^5.3.0",
		"cesium": "1.146.0",
		"next": "16.4.3",
		"react": "19.2.9",
		"react-dom": "19.2.9"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "^24.19.2",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.4.3",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"vitest": "~4.1.12"
	}
}
