POSTGRES_USER=serendipeak
POSTGRES_PASSWORD=serendipeak
POSTGRES_DB=serendipeak
POSTGRES_PORT=5434
DATABASE_URL=postgres://serendipeak:serendipeak@localhost:5434/serendipeak
APP_ENV=development
DJANGO_SECRET_KEY=development-only-insecure-secret-key-do-not-use-elsewhere
# Production: bare host names only, plus the platform health-check host (healthcheck.railway.app on Railway).
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Where the Studio sends editors for the visual camera editor and the draft preview. One bare origin, https outside development.
WEB_ORIGIN=http://localhost:3000
# Signs draft-preview tokens. At least 32 characters, different from DJANGO_SECRET_KEY; changing it ends every outstanding preview.
PREVIEW_SIGNING_KEY=
# Optional. How many reverse proxies in front of the service append to X-Forwarded-For (0 ignores the header). Set it behind a proxy so sign-in throttling counts the client, not the proxy.
# TRUSTED_PROXY_HOPS=0
# Production behind a TLS-terminating proxy needs TRUSTED_PROXY_HOPS above 0 (then X-Forwarded-Proto is trusted) or CSRF_TRUSTED_ORIGINS, comma separated https origins.
# CSRF_TRUSTED_ORIGINS=
# 0 or 1. Default 1 in production behind a trusted proxy. /healthz is never redirected.
# SECURE_SSL_REDIRECT=1
# Optional HSTS lifetime in seconds; production behind a trusted proxy only. Browsers remember it, so start low.
# SECURE_HSTS_SECONDS=300
# Photograph media: filesystem (local development only; rejected in production) or s3 (an S3-compatible store such as R2).
MEDIA_STORE=filesystem
# filesystem only. Relative to services/api; originals and public renditions live in separate
# subdirectories, and only public renditions are served, in development only.
MEDIA_ROOT=.media
# Where public renditions are served from. https outside development, no trailing slash.
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media
# s3 only. Credentials come from the environment, never from a committed file.
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BUCKET=
MEDIA_ORIGINALS_BUCKET=
# Web only. Next reads it from apps/web/.env.local and inlines it at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Web only. Cesium ion access token; without it the 3D stage reports that the globe is unavailable.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Web only. sentinel2, world or none. Unset: sentinel2 in development, world in production.
# NEXT_PUBLIC_CESIUM_IMAGERY_MODE=world
# Web only, read by the server at request time. The public origin for absolute URLs such as canonical links; unset publishes none.
# SITE_ORIGIN=http://localhost:3000
# Optional macOS/Homebrew overrides. Leave unset when GDAL/GEOS are discoverable by the system.
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
