POSTGRES_USER=serendipeak
POSTGRES_PASSWORD=serendipeak
POSTGRES_DB=serendipeak
POSTGRES_PORT=5434
DATABASE_URL=postgres://serendipeak:serendipeak@localhost:5434/serendipeak
APP_ENV=development
DJANGO_SECRET_KEY=development-only-insecure-secret-key-do-not-use-elsewhere
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Web only. Next reads it from apps/web/.env.local and inlines it at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional macOS/Homebrew overrides. Leave unset when GDAL/GEOS are discoverable by the system.
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
# Legacy catalog export only. Read-only connection to the legacy database.
# LEGACY_DATABASE_URL=postgres://serendipeak:serendipeak@localhost:5433/serendipeak
