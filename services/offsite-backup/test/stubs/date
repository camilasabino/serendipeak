#!/bin/sh
# Forces the weekday and gives BSD date (macOS) the GNU `-d @seconds` form the script relies on.
if [ -n "${FAKE_WEEKDAY:-}" ] && [ "$*" = "-u +%u" ]; then
  echo "$FAKE_WEEKDAY"
  exit 0
fi
# Gives every manifest name its own second, so two runs inside one test never collide on a key.
if [ -n "${FAKE_TICKING_CLOCK:-}" ] && [ "$*" = "-u +%Y%m%dT%H%M%SZ" ]; then
  tick="$(cat "$FAKE_TICKING_CLOCK" 2>/dev/null || echo 0)"
  echo $((tick + 1)) >"$FAKE_TICKING_CLOCK"
  exec "$0" -u -d "@$(($(/bin/date +%s) + tick))" +%Y%m%dT%H%M%SZ
fi
if [ "$1" = "-u" ] && [ "$2" = "-d" ] && ! /bin/date -u -d @0 >/dev/null 2>&1; then
  seconds="${3#@}"
  shift 3
  exec /bin/date -u -r "$seconds" "$@"
fi
exec /bin/date "$@"
