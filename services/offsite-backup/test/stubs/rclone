#!/bin/sh
# Stand-in for rclone over directories: the remote `src:<path>` is $STATE/src/<path> and `dst:<path>`
# is $STATE/dst/<path>. Each call is recorded so tests can see which verbs and flags were used.
echo "$*" >>"$STATE/rclone-argv.log"

cfg=""
files_from=""
ignore_existing=""
positional=""
while [ $# -gt 0 ]; do
  case "$1" in
    --config) cfg="$2"; shift 2 ;;
    --files-from) files_from="$2"; shift 2 ;;
    --log-level | --transfers | --checkers | --format | --separator) shift 2 ;;
    --ignore-existing) ignore_existing=1; shift ;;
    --recursive | --files-only | --download) shift ;;
    -*) echo "rclone stub: unknown flag $1" >&2; exit 99 ;;
    *) positional="$positional $1"; shift ;;
  esac
done

# shellcheck disable=SC2086
set -- $positional
verb="$1"
shift
echo "rclone $verb" >>"$STATE/events.log"

[ -f "$cfg" ] && grep -q '^\[src\]' "$cfg" && grep -q '^\[dst\]' "$cfg" || {
  echo "rclone stub: configuration missing" >&2
  exit 98
}

resolve() {
  case "$1" in
    src:*) echo "$STATE/src/${1#src:}" ;;
    dst:*) echo "$STATE/dst/${1#dst:}" ;;
    *) echo "$1" ;;
  esac
}

files_in() {
  if [ -n "$files_from" ]; then
    cat "$files_from"
  else
    (cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
  fi
}

case "$verb" in
  lsf)
    case "$1" in
      src:*) [ -z "${FAKE_LSF_SRC_EXIT:-}" ] || exit "$FAKE_LSF_SRC_EXIT" ;;
      dst:*) [ -z "${FAKE_LSF_DST_EXIT:-}" ] || exit "$FAKE_LSF_DST_EXIT" ;;
    esac
    dir="$(resolve "$1")"
    [ -d "$dir" ] || exit 3
    files_in "$dir" | while read -r file; do
      printf '%s;%s\n' "$file" "$(wc -c <"$dir/$file" | tr -d ' ')"
    done
    ;;

  hashsum)
    [ "${FAKE_HASH_EXIT:-0}" = "0" ] || exit "$FAKE_HASH_EXIT"
    shift
    dir="$(resolve "$1")"
    status=0
    while read -r file; do
      if [ -f "$dir/$file" ]; then
        printf '%s  %s\n' "$(sha256sum "$dir/$file" | cut -d' ' -f1)" "$file"
      else
        status=1
      fi
    done <"$files_from"
    exit "$status"
    ;;

  copy)
    from="$(resolve "$1")"
    to="$(resolve "$2")"
    [ -d "$from" ] || exit 3

    [ "${FAKE_COPY_ALWAYS_FAIL:-}" != "1" ] || exit 1
    interrupted=""
    if [ -n "${FAKE_COPY_FAIL_FIRST:-}" ]; then
      case "$2" in
        dst:*)
          count="$(cat "$STATE/copy-calls" 2>/dev/null || echo 0)"
          echo $((count + 1)) >"$STATE/copy-calls"
          [ "$count" -ge "$FAKE_COPY_FAIL_FIRST" ] || interrupted=1
          ;;
      esac
    fi

    copied=0
    for file in $(files_in "$from"); do
      [ -f "$from/$file" ] || continue
      if [ -n "$ignore_existing" ] && [ -e "$to/$file" ]; then
        continue
      fi
      mkdir -p "$(dirname "$to/$file")"
      cp "$from/$file" "$to/$file"

      case "$2" in
        dst:*)
          echo "copied ${2#dst:}/$file" >>"$STATE/events.log"
          if [ -n "${FAKE_COPY_TRUNCATE:-}" ]; then
            case "$file" in *"$FAKE_COPY_TRUNCATE"*) head -c 3 "$from/$file" >"$to/$file" ;; esac
          fi
          if [ -n "${FAKE_COPY_FLIP:-}" ]; then
            case "$file" in *"$FAKE_COPY_FLIP"*) { printf X; tail -c +2 "$from/$file"; } >"$to/$file" ;; esac
          fi
          ;;
      esac

      copied=$((copied + 1))
      if [ -n "$interrupted" ] && [ "$copied" -ge 1 ]; then
        exit 1
      fi
    done
    ;;

  copyto)
    from="$(resolve "$1")"
    to="$(resolve "$2")"
    [ -f "$from" ] || exit 3
    if [ -n "$ignore_existing" ] && [ -e "$to" ]; then
      exit 0
    fi
    mkdir -p "$(dirname "$to")"
    cp "$from" "$to"
    case "$2" in
      dst:*) echo "copied ${2#dst:}" >>"$STATE/events.log" ;;
    esac
    if [ -n "${FAKE_MANIFEST_READBACK_CORRUPT:-}" ]; then
      case "$1" in dst:*/manifests/*) echo "garbage" >"$to" ;; esac
    fi
    ;;

  *)
    echo "rclone stub: unsupported verb $verb" >&2
    exit 97
    ;;
esac
